{
  "name": "shoplite-catalog",
  "version": "1.2.0",
  "private": true,
  "description": "ShopLite catalog microservice",
  "main": "src/server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.js",
