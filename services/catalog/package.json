    "@opentelemetry/instrumentation-pg": "^0.77.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0"
