%% Week 7 · Configuration injection: ConfigMaps (non-sensitive, in Git) vs Secrets (sensitive, never in Git)
flowchart LR
    subgraph GIT["Git repository"]
        CMY["k8s/shop/configmaps.yaml<br/>reviewed, versioned"]
        ENV["k8s/shop/secrets/db.env<br/>git-ignored · generated by k8s-up.sh"]
        KZ["kustomization.yaml<br/>secretGenerator"]
    end

    subgraph API["kube-apiserver / etcd · ns shop"]
        CM1["ConfigMap catalog-config<br/>PGHOST · PGPORT · PGDATABASE · PGUSER"]
        CM2["ConfigMap orders-config<br/>PG* · CATALOG_URL · CATALOG_TIMEOUT_MS"]
        CM3["ConfigMap web-config<br/>config.json"]
        CM4["ConfigMap postgres-init<br/>10-service-databases.sh"]
        SEC["Secret db-credentials-&lt;hash&gt;<br/>POSTGRES_PASSWORD<br/>CATALOG_DB_PASSWORD<br/>ORDERS_DB_PASSWORD"]
    end

    subgraph PODS["Pods"]
        CAT["catalog<br/>environment variables"]
        ORD["orders<br/>environment variables"]
        WEB["web (nginx)<br/>file /usr/share/nginx/html/config/config.json"]
        PG["postgres-0<br/>files /run/secrets/db/* (0440)<br/>+ /docker-entrypoint-initdb.d/"]
    end

    CMY --> CM1 & CM2 & CM3 & CM4
    ENV --> KZ --> SEC

    CM1 -- "envFrom" --> CAT
    SEC -- "secretKeyRef → PGPASSWORD" --> CAT
    CM2 -- "envFrom" --> ORD
    SEC -- "secretKeyRef → PGPASSWORD" --> ORD
    CM3 -- "volume · hot-reloaded" --> WEB
    CM4 -- "volume · 0555" --> PG
    SEC -- "volume · POSTGRES_PASSWORD_FILE" --> PG

    classDef cm fill:#eef4fb,stroke:#2f5d8a,color:#1d1d1b
    classDef sec fill:#fde8e8,stroke:#b42318,color:#7a1610
    classDef pod fill:#e7f6ec,stroke:#1f7a3f,color:#14532d
    classDef src fill:#f4f4f2,stroke:#6b6b66,color:#1d1d1b
    class CM1,CM2,CM3,CM4 cm
    class SEC,ENV sec
    class CAT,ORD,WEB,PG pod
    class CMY,KZ src
