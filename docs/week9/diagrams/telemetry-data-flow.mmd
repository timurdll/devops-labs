%% Week 9 · Observability data flow: App runtime → OpenTelemetry Collector → Prometheus / Jaeger → Grafana.
%% Thick = traces (push, OTLP) · dashed = metrics (pull by the Collector, then remote write) · dotted = queries.
flowchart TB
    U(["client · curl / browser<br/>Host: &lt;env&gt;.shop.local → :8080 → NodePort 30080"])

    subgraph RT["① App runtime — shop-dev · shop-staging · shop-prod · ingress-traefik"]
        direction LR
        T["<b>Traefik</b> v3.7<br/>root span, injects traceparent<br/>:9000/metrics — edge RED"]
        W["<b>web</b> nginx<br/>static · no SDK"]
        O["<b>orders</b> 1.1.0<br/>OTel SDK http · undici · pg<br/>prom-client /metrics"]
        C["<b>catalog</b> 1.1.0<br/>OTel SDK http · pg<br/>prom-client /metrics"]
        P[("postgres")]
        T -- traceparent --> W
        T -- traceparent --> O
        T -- traceparent --> C
        O -- "fetch + traceparent" --> C
        O --> P
        C --> P
    end

    subgraph COL["② OpenTelemetry Collector 0.163 — namespace observability, gateway, 1 replica"]
        direction LR
        R1["receiver <b>otlp</b><br/>:4317 gRPC · :4318 HTTP"]
        R2["receiver <b>prometheus</b><br/>kubernetes_sd role=pod<br/>prometheus.io/scrape=true · every 15 s"]
        PR["processors<br/>memory_limiter → k8s_attributes → batch"]
        E1["exporter <b>otlp_grpc/jaeger</b>"]
        E2["exporter <b>prometheus_remote_write</b>"]
        R1 --> PR
        R2 --> PR
        PR -- traces --> E1
        PR -- metrics --> E2
    end

    subgraph ST["③ Storage — namespace observability"]
        direction LR
        J[("<b>Jaeger</b> v2.20<br/>in-memory · 20 000 traces<br/>query API :16686")]
        PM[("<b>Prometheus</b> v3.15<br/>remote-write receiver · exemplars<br/>RED recording + alert rules")]
    end

    G["④ <b>Grafana</b> 13.2 — RED dashboard (provisioned from git)<br/>exemplar ▸ trace · trace ▸ related metrics"]
    OP(["operator · kubectl port-forward :3000"])

    U --> T
    RT == "OTLP/HTTP spans<br/>(Traefik, orders, catalog)" ==> R1
    R2 -. "GET /metrics<br/>orders, catalog :8080 · Traefik :9000" .-> RT
    E1 == "OTLP gRPC" ==> J
    E2 -. "remote write + trace_id exemplars" .-> PM
    G -. PromQL .-> PM
    G -. "Jaeger API" .-> J
    OP -.-> G

    classDef app fill:#E8F1FB,stroke:#2E74B5,color:#1F4E79
    classDef col fill:#FFF4E5,stroke:#E69138,color:#783F04
    classDef store fill:#EAF5EA,stroke:#38761D,color:#274E13
    classDef viz fill:#F3E8FB,stroke:#8E44AD,color:#4A235A
    class T,W,O,C,P app
    class R1,R2,PR,E1,E2 col
    class J,PM store
    class G viz
