%% What lives where: git repository → Argo CD objects → cluster namespaces (top to bottom).
flowchart TB
    subgraph GIT["① GitHub · timurdll/devops-labs @ week8-gitops-helm — desired state"]
        direction LR
        gb["gitops/bootstrap/<br/>root.yaml"]
        ga["gitops/apps/<br/>projects · platform · shoplite"]
        kp["k8s/platform/<br/>traefik · environments"]
        ch["charts/shoplite/<br/>+ environments/&lt;env&gt;/values.yaml"]
    end

    subgraph ARGO["② namespace argocd · Argo CD v3.5.6 — reconcilers"]
        direction LR
        root["Application <b>root</b><br/>app of apps"]
        subgraph DEF["defined by gitops/apps"]
            direction LR
            proj["AppProjects<br/><b>platform</b> · <b>shoplite</b>"]
            plat["Application <b>platform</b><br/>auto · selfHeal · no prune"]
            as["ApplicationSet <b>shoplite</b><br/>list: dev · staging · prod"]
        end
        subgraph GEN["generated by the ApplicationSet"]
            direction LR
            ad["shoplite-dev<br/>auto · prune · selfHeal"]
            ast["shoplite-staging<br/>auto · prune · selfHeal"]
            ap["shoplite-prod<br/><b>manual sync</b>"]
        end
    end

    subgraph K8S["③ kind cluster shoplite — actual state"]
        direction LR
        it["ingress-traefik<br/>Traefik ×2"]
        nd["shop-dev"]
        ns["shop-staging"]
        np["shop-prod"]
    end

    gb -. "kubectl apply once (gitops-up.sh)" .-> root
    ga -- "pulled by" --> root
    root -- creates --> DEF
    kp -- "pulled by" --> plat
    ch -- "pulled by" --> GEN
    as -- generates --> GEN
    proj -. limits .-> plat
    plat -- "namespaces, RBAC, Traefik" --> it
    ad --> nd
    ast --> ns
    ap --> np

    classDef git fill:#fff6e0,stroke:#b07d10;
    classDef argo fill:#eef4fb,stroke:#2f5d8a;
    classDef k8s fill:#e7f6ec,stroke:#2e7d4f;
    class gb,ga,kp,ch git;
    class root,proj,plat,as,ad,ast,ap argo;
    class it,nd,ns,np k8s;
