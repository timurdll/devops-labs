{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/timurdll/devops-labs/charts/shoplite/values.schema.json",
  "title": "ShopLite chart values",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "global",
    "image",
    "ingress",
    "services",
    "postgres",
    "database",
    "mesh"
  ],
  "$defs": {
    "quantity": {
      "type": [
        "string",
        "number"
      ],
      "pattern": "^[0-9]+(\\.[0-9]+)?(m|Ki|Mi|Gi)?$"
    },
    "tag": {
      "type": "string",
      "pattern": "^$|^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$",
      "not": {
        "const": "latest"
      },
      "description": "immutable tag; 'latest' is rejected"
    },
    "httpPath": {
      "type": "string",
      "pattern": "^/[A-Za-z0-9/_.-]*$"
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "component",
        "tier",
        "replicas",
        "image",
        "runAsUser",
        "probes",
        "resources"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "component": {
          "enum": [
            "api",
            "frontend"
          ]
        },
        "tier": {
          "enum": [
            "backend",
            "frontend"
          ]
        },
        "replicas": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "pattern": "^[a-z0-9]+([._/-][a-z0-9]+)*$"
            },
            "tag": {
              "$ref": "#/$defs/tag"
            }
          }
        },
        "runAsUser": {
          "type": "integer",
          "minimum": 1,
          "description": "non-root UID (PSA restricted)"
        },
        "probes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "readinessPath",
            "livenessPath"
          ],
          "properties": {
            "readinessPath": {
              "$ref": "#/$defs/httpPath"
            },
            "livenessPath": {
              "$ref": "#/$defs/httpPath"
            }
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requests",
            "limits"
          ],
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cpu": {
                  "$ref": "#/$defs/quantity"
                },
                "memory": {
                  "$ref": "#/$defs/quantity"
                }
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cpu": {
                  "$ref": "#/$defs/quantity"
                },
                "memory": {
                  "$ref": "#/$defs/quantity"
                }
              }
            }
          }
        },
        "ingressPath": {
          "oneOf": [
            {
              "const": ""
            },
            {
              "$ref": "#/$defs/httpPath"
            }
          ]
        },
        "database": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "passwordKey"
          ],
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,30}$"
            },
            "passwordKey": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            }
          }
        },
        "env": {
          "type": "object",
          "description": "extra non-secret env vars (values must be strings)",
          "propertyNames": {
            "pattern": "^[A-Z][A-Z0-9_]*$",
            "not": {
              "pattern": "(PASSWORD|SECRET|TOKEN|KEY)"
            }
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "allowFrom": {
          "type": "array",
          "items": {
            "enum": [
              "web",
              "catalog",
              "orders"
            ]
          },
          "uniqueItems": true
        },
        "uiConfig": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "shopName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "banner": {
              "type": "string",
              "maxLength": 120
            }
          }
        },
        "instrumented": {
          "type": "boolean",
          "description": "Exposes /metrics and emits OpenTelemetry spans."
        },
        "version": {
          "type": "string",
          "pattern": "^v[0-9]+$",
          "description": "pod label `version` of the stable Deployment (mesh subset)"
        },
        "canary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "version",
            "image",
            "replicas",
            "weight"
          ],
          "description": "Week 10: weighted canary release through the mesh",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "version": {
              "type": "string",
              "pattern": "^v[0-9]+$"
            },
            "image": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "tag"
              ],
              "properties": {
                "tag": {
                  "$ref": "#/$defs/tag"
                }
              }
            },
            "replicas": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "weight": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          },
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "image": {
                "properties": {
                  "tag": {
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "rollout": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "steps",
            "pauseSeconds",
            "analysis"
          ],
          "description": "Week 12: Argo Rollouts canary with Prometheus analysis (needs mesh.enabled; excludes canary.enabled)",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "steps": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10,
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 99
              },
              "description": "canary weights in %, ascending; 100 is implied at the end"
            },
            "pauseSeconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3600
            },
            "analysis": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "interval",
                "window",
                "maxErrorRate",
                "errorFailureLimit",
                "maxP95Ms",
                "latencyFailureLimit"
              ],
              "properties": {
                "interval": {
                  "$ref": "#/$defs/duration"
                },
                "window": {
                  "type": "string",
                  "pattern": "^[0-9]+(s|m)$"
                },
                "maxErrorRate": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1
                },
                "errorFailureLimit": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10
                },
                "maxP95Ms": {
                  "type": "integer",
                  "minimum": 1
                },
                "latencyFailureLimit": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10
                }
              }
            }
          }
        }
      }
    },
    "duration": {
      "type": "string",
      "pattern": "^[0-9]+(ms|s|m)$"
    }
  },
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment"
      ],
      "properties": {
        "environment": {
          "enum": [
            "dev",
            "staging",
            "prod"
          ]
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registry": {
          "type": "string",
          "pattern": "^$|^[a-z0-9.-]+(:[0-9]+)?(/[a-z0-9._-]+)*$"
        },
        "tag": {
          "$ref": "#/$defs/tag"
        },
        "pullPolicy": {
          "enum": [
            "IfNotPresent",
            "Always"
          ]
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "className",
        "host"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string",
          "minLength": 1
        },
        "host": {
          "type": "string",
          "format": "hostname",
          "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
        }
      }
    },
    "podDefaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 300
        },
        "preStopSleepSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30
        },
        "revisionHistoryLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "topologySpread": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "whenUnsatisfiable": {
              "enum": [
                "DoNotSchedule",
                "ScheduleAnyway"
              ]
            }
          }
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "description": "Week 9: OpenTelemetry tracing + Prometheus scraping of instrumented services.",
      "required": [
        "enabled",
        "otlpEndpoint",
        "samplingRatio",
        "collector"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "otlpEndpoint": {
          "type": "string",
          "pattern": "^https?://[a-z0-9.-]+(:[0-9]{1,5})?/?$"
        },
        "samplingRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "collector": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "namespace",
            "podName"
          ],
          "properties": {
            "namespace": {
              "type": "string",
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
            },
            "podName": {
              "type": "string"
            }
          }
        }
      }
    },
    "mesh": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "mtlsMode",
        "authorization",
        "gateway",
        "trafficPolicy",
        "routes"
      ],
      "description": "Week 10: Istio service mesh",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "mtlsMode": {
          "enum": [
            "STRICT",
            "PERMISSIVE"
          ]
        },
        "authorization": {
          "type": "boolean"
        },
        "gateway": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "replicas",
            "resources"
          ],
          "properties": {
            "replicas": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "resources": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "requests",
                "limits"
              ],
              "properties": {
                "requests": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "cpu": {
                      "$ref": "#/$defs/quantity"
                    },
                    "memory": {
                      "$ref": "#/$defs/quantity"
                    }
                  }
                },
                "limits": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "cpu": {
                      "$ref": "#/$defs/quantity"
                    },
                    "memory": {
                      "$ref": "#/$defs/quantity"
                    }
                  }
                }
              }
            },
            "rateLimit": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "enabled",
                "requestsPerSecond",
                "burst"
              ],
              "description": "Week 11: Envoy local rate limit at the gateway (429 above the budget)",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "requestsPerSecond": {
                  "type": "integer",
                  "minimum": 1
                },
                "burst": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        },
        "trafficPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "connectTimeout",
            "outlierDetection"
          ],
          "properties": {
            "connectTimeout": {
              "$ref": "#/$defs/duration"
            },
            "outlierDetection": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "consecutive5xxErrors",
                "interval",
                "baseEjectionTime",
                "maxEjectionPercent"
              ],
              "properties": {
                "consecutive5xxErrors": {
                  "type": "integer",
                  "minimum": 1
                },
                "interval": {
                  "$ref": "#/$defs/duration"
                },
                "baseEjectionTime": {
                  "$ref": "#/$defs/duration"
                },
                "maxEjectionPercent": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                }
              }
            },
            "http": {
              "type": "object",
              "additionalProperties": false,
              "description": "Week 11: bulkhead (DestinationRule connectionPool.http)",
              "properties": {
                "http1MaxPendingRequests": {
                  "type": "integer",
                  "minimum": 1
                },
                "http2MaxRequests": {
                  "type": "integer",
                  "minimum": 1
                },
                "maxRetries": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        },
        "routes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "timeout",
            "retries"
          ],
          "description": "Week 11: per-route deadline and transport retries (VirtualService)",
          "properties": {
            "timeout": {
              "$ref": "#/$defs/duration"
            },
            "retries": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "attempts",
                "perTryTimeout",
                "retryOn"
              ],
              "properties": {
                "attempts": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 5
                },
                "perTryTimeout": {
                  "$ref": "#/$defs/duration"
                },
                "retryOn": {
                  "type": "string",
                  "pattern": "^(connect-failure|refused-stream|reset|5xx|gateway-error|retriable-4xx|unavailable|cancelled)(,(connect-failure|refused-stream|reset|5xx|gateway-error|retriable-4xx|unavailable|cancelled))*$"
                }
              }
            }
          }
        }
      }
    },
    "services": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "catalog": {
          "$ref": "#/$defs/service"
        },
        "orders": {
          "$ref": "#/$defs/service"
        },
        "web": {
          "$ref": "#/$defs/service"
        }
      }
    },
    "postgres": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "string",
          "pattern": "@sha256:[a-f0-9]{64}$",
          "description": "third-party image: digest-pinned"
        },
        "runAsUser": {
          "type": "integer",
          "minimum": 1
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "size": {
              "type": "string",
              "pattern": "^[0-9]+(Mi|Gi)$"
            },
            "storageClassName": {
              "type": "string"
            }
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cpu": {
                  "$ref": "#/$defs/quantity"
                },
                "memory": {
                  "$ref": "#/$defs/quantity"
                }
              }
            },
            "limits": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cpu": {
                  "$ref": "#/$defs/quantity"
                },
                "memory": {
                  "$ref": "#/$defs/quantity"
                }
              }
            }
          }
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "existingSecret"
      ],
      "properties": {
        "existingSecret": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        }
      }
    },
    "networkPolicies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingressController": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "namespace": {
              "type": "string"
            },
            "podName": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
